# Copy to .env and edit. Every value is optional; these are the defaults.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=codedna
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=codedna_pass
REDIS_HOST=localhost
REDIS_PORT=6379
CASSANDRA_HOSTS=localhost
CASSANDRA_KEYSPACE=codedna

# Optional GitHub token: adds stars, forks, topics, license and pull-request counts
GITHUB_TOKEN=

# Where cloned repositories are kept. Choose a folder OUTSIDE OneDrive/Dropbox: the
# 30 repositories take about 1 GB and sync tools slow down git.
CODEDNA_DATA=data

# Worker processes for big repositories (default: CPU count, at most 8). 1 turns parallel mode
# off. Results are identical either way.
# CODEDNA_WORKERS=4

# Per-repository caps
CODEDNA_MAX_COMMITS=2000
CODEDNA_MAX_FILES=3000

# 1 = use in-memory stand-ins for unreachable databases. For tests only; never for paper results.
CODEDNA_FALLBACK=0
